package com.semanticsquare.GenericsDemo;

import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;

//functional interface is introduced in java 8 and its used for Lambda expressions
//lambda expressions are worked on the method on the interface

@FunctionalInterface
interface Lambda{
	void show();
}

public class lambdaPractice {
	
	public static void main(String[] args) {
		
		//below functionality is called Functional expression
		//or inner class where we are declaring the class for Lambda Interface as inline class
		//we are implementing the show method at the declaraion which is introduced from Java 8 
		
		
		Lambda lam = new Lambda() {
			public void show() {
				System.out.println("Hello world");
			}
		};
		lam.show();	
		
		//another way of implementation of above: remove below code:
		//new Lambda() {
			//public void show
		
		Lambda lam1 = () -> {System.out.println("Hello world");};
		lam1.show();
		
		//another way 
		
		Lambda lam2 = () -> System.out.println("heelo world another way");
		lam2.show();
	}
}

