package com.semanticsquare.GenericsDemo;

interface Operation<T1, T2, T> {
	  void performOperation(T1 firstVal, T2 secondVal, T a);
}
public class GenericsPractice {
	
	
	public static void main(String[] args) {
		Operation<Integer, Integer, String> operate = new OperationPerformed<>();
		
		operate.performOperation(8 , 5, "A");
	}
}


class OperationPerformed<T1 extends Number, T2 extends Number, T extends String> implements Operation<T1, T2, T> {
	
		T a;
		T1 b;
		T2 c;
		
	@Override
	public void performOperation(T1 b, T2 c, T a) {
		// TODO Auto-generated method stub
		
		switch (a.toString()) {
		case "M": {
			
			System.out.println("You selected multiplication"+  b.doubleValue() * c.doubleValue());
			break;
		}
		case "A":{
			System.out.println("You selected addition"+  b.doubleValue() + c.doubleValue());
			break;
		}
		case "D":{
			System.out.println("You selected division"+  b.doubleValue() / c.doubleValue());
			break;
		}
		case "S":{
			
			//System.out.println("You selected subtraction" +  b.doubleValue()-c.doubleValue());
		}
		
		default:
			throw new IllegalArgumentException("Unexpected value: " + a);
		}
		//System.out.println("You selected multiplication"+  b.doubleValue() * c.doubleValue());
	}
	
}
