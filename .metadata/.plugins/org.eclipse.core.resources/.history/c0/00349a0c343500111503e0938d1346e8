package com.learning;

public class HSBCBank
{
	private double amount;
	
	public HSBCBank(double amount)
	{
		this.amount = amount;
	}
	synchronized public void balanceCheck() {
		System.out.println("The balance for the account is " + this.amount);
	}
	synchronized public void withDrawl (double withdraw) {
		this.amount -=  withdraw;
		System.out.println("The balance amount after with drawl amount is " + this.amount);
	}
	
	synchronized public void deposit(double deposit)
	{
		this.amount += deposit;
		System.out.println("The balance after deposit is " + this.amount);
	}
}
