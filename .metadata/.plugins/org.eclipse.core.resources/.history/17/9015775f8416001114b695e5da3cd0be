package com.suneetha.oopsbasics;


class Math{
	
	public static double pi = 3.14;
	
	 int add(int a, int b)
	 {
		System.out.println(" add 2 numbers");
		return 0;
	};
	
	 int sub(int a, int b) 
	 {
		System.out.println(" subtract 2 numbers");
		return 0;
	};
	
	int div(int a, int b) 
	{
		System.out.println(" divide 2 numbers");
		return 0;
	};
	
	int mul(int a, int b) 
	{
		System.out.println(" multiply 2 numbers");
		return 0;
	};
}

class Add extends Math
{
	
	int add(int a, int b ) {
		
		return a+b;
	}
	
	double radius(int rad) {
		
		return 2 * Math.pi * rad;
		
	}
}


public class InheritanceLesson {
	
	public static void main(String[] args) {
		
		Math m = new Add(); //run time Polymorphism
		System.out.println(m.add(5, 6));
		
		System.out.println("circumference of circle is " + ((Add) m).radius(6));// for specialized methods referencing the parent we need to downcast otherwise its not recognizable
		
		
		
	}

}
