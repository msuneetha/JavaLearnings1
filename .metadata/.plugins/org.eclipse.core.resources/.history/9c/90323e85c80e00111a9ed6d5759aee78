package com.semanticsquare.GenericsDemo;

import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;

//functional interface is introduced in java 8 and its used for Lambda expressions
//lambad expressions are worked on the method on the interface

@FunctionalInterface
interface lambda{
	void show();
}

public class lambdaPractice {
	
	List<Integer> list1 = new ArrayList<>();
	
	public static void main(String[] args) {
		
		List<Integer> list1 = new ArrayList<>(Arrays.asList(1,5,6,12,34,56,12,4,7,9));
		
		for(int val : list1) { val -> val * 2};
		
		
		System.out.println(list1.stream().sorted().toList());
		
	
	}
	
	

}
