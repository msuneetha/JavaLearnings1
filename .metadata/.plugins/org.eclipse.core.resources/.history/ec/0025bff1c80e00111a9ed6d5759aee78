package com.semanticsquare.GenericsDemo;

import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;

//functional interface is introduced in java 8 and its used for Lambda expressions
//lambda expressions are worked on the method on the interface

@FunctionalInterface
interface Lambda{
	void show();
}

public class lambdaPractice {
	
	public static void main(String[] args) {
		Lambda lam = new Lambda() {
			public void show() {
				System.out.println("Hello world");
			}
		};
		lam.show();	
	}
}
	
	

}
