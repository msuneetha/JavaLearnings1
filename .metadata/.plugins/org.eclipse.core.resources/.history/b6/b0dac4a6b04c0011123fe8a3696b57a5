<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <title>Restaurant Menu</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Our Menu</h2>
        <a href={/addMenu}Add New Item</a>
        <button class="btn btn-primary">Add New Item</button>
    </div>

    <table class="table table-hover table-striped">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Item Name</th>
                <th>Category</th>
                <th>Price</th>
                <th>Dietary</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            <tr th:each="item : ${menuItems}">
                <td th:text="${item.id}">1</td>
                <td th:text="${item.description}">Description</td>
                <td th:text="${item.typeOfItem}">Appetizer</td>
                <td th:text="${'$' + item.price}">$0.00</td>
                <td>
                    <span th:if="${item.vegOrNonVeg}" class="badge bg-success">Veg</span>
                    <span th:unless="${item.vegOrNonVeg}" class="badge bg-danger">Non-Veg</span>
                </td>
                <td>
                    <span th:text="${item.isAvailable} ? 'In Stock' : 'Out of Stock'"
                          th:class="${item.isAvailable} ? 'text-success' : 'text-danger'">
                    </span>
                </td>
            </tr>
        </tbody>
    </table>

</body>
</html>